# taklifim.uz (deploy/compose.yml). The domains and bucket match
# SITE_DOMAIN, FILES_DOMAIN and S3_BUCKET in deploy/.env: change both together.

taklifim.uz {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	# A fresh ID per request (replacing any the visitor sent). Next.js passes
	# it to the API, and both log under it; error responses include it.
	request_header X-Request-Id {http.request.uuid}
	# Sets X-Forwarded-For to the visitor's address (it doesn't trust what
	# the visitor sent), which is what TRUSTED_PROXY_COUNT=1 expects.
	reverse_proxy taklifim-web:3001
}

www.taklifim.uz {
	redir https://taklifim.uz{uri} permanent
}

# Public files (photos, music). Only reading objects of the bucket gets
# through: MinIO's S3 API (uploads, admin) stays private.
files.taklifim.uz {
	header Strict-Transport-Security "max-age=31536000"

	# An object's own key only: no bucket listing.
	@read {
		method GET HEAD
		path_regexp ^/taklifim/.+
	}
	handle @read {
		reverse_proxy taklifim-minio:9000
	}
	handle {
		respond 404
	}
}
