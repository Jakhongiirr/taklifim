# Production settings for deploy/compose.yml. Copy to .env (never commit it)
# and fill in. Generate each secret with: openssl rand -hex 32

# --- Domains (both need DNS A records pointing at this server) ---
# Caddy's routes for them are in sites/taklifim.caddy of the caddy repo:
# change both together.
SITE_DOMAIN=taklifim.uz
FILES_DOMAIN=files.taklifim.uz

# --- Secrets ---
# Shared by the Next.js server and the API.
INTERNAL_API_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Postgres ---
DB_USER=taklifim
DB_PASSWORD=
DB_NAME=taklifim

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO (file storage) ---
S3_ACCESS_KEY=taklifim
S3_SECRET_KEY=
# Also in the caddy repo's sites/taklifim.caddy.
S3_BUCKET=taklifim

# --- Login ---
# Users log in by sharing their phone number with this bot. Create it with
# @BotFather (see README). Use a different bot for development: only one
# server can receive a bot's messages at a time.
TELEGRAM_BOT_TOKEN=
# Telegram then sends the bot's messages to https://SITE_DOMAIN/api/telegram
# with this secret (openssl rand -hex 32). Empty: the API polls for them,
# which works with one API container only.
TELEGRAM_WEBHOOK_SECRET=

# --- Payme ---
PAYME_MERCHANT_ID=
PAYME_KEY=
# Sandbox while certifying: https://checkout.test.paycom.uz
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Fiscal receipts, once Payme asks for them.
PAYME_IKPU=
PAYME_PACKAGE_CODE=
PAYME_VAT_PERCENT=0

# --- Logs and alerts ---
# fatal, error, warn, info, debug
LOG_LEVEL=info
# Errors of the API and the website go to this Telegram chat (see README).
# Empty: no alerts.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Backups (backup.sh) ---
# Off-server copy with restic (e.g. sftp:user@backup-host:/taklifim, or an
# S3 URL). Empty: backups stay on this server only.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# --- Maps ---
# Yandex keys for the invitation builder's map picker
# (developer.tech.yandex.ru: "JavaScript API and HTTP Geocoder"; optional
# "Geosuggest" for search suggestions). Empty: owners paste a map link
# instead. Guest pages show the venue map without a key.
YANDEX_MAPS_API_KEY=
YANDEX_MAPS_SUGGEST_API_KEY=
