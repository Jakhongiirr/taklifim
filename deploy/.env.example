# Production settings for deploy/compose.yml. Copy to .env (never commit it)
# and fill in. Generate each secret with: openssl rand -hex 32

# --- Domains (both need DNS A records pointing at this server) ---
SITE_DOMAIN=taklifim.uz
FILES_DOMAIN=files.taklifim.uz
# Let's Encrypt notices.
ACME_EMAIL=

# --- Secrets ---
# Shared by the Next.js server and the API.
INTERNAL_API_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Postgres ---
DB_USER=taklifim
DB_PASSWORD=
DB_NAME=taklifim

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO (file storage) ---
S3_ACCESS_KEY=taklifim
S3_SECRET_KEY=
S3_BUCKET=taklifim

# --- Login codes ---
TELEGRAM_GATEWAY_TOKEN=

# --- Payme ---
PAYME_MERCHANT_ID=
PAYME_KEY=
# Sandbox while certifying: https://checkout.test.paycom.uz
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Fiscal receipts, once Payme asks for them.
PAYME_IKPU=
PAYME_PACKAGE_CODE=
PAYME_VAT_PERCENT=0

# --- Logs and alerts ---
# fatal, error, warn, info, debug
LOG_LEVEL=info
# Errors of the API and the website go to this Telegram chat (see README).
# Empty: no alerts.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Backups (backup.sh) ---
# Off-server copy with restic (e.g. sftp:user@backup-host:/taklifim, or an
# S3 URL). Empty: backups stay on this server only.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
