NODE_ENV=development
PORT=3000

# Number of reverse proxies in front of the API (0 = none, e.g. local dev).
# Only matters for clients calling the API directly; the Next.js server is
# recognized by INTERNAL_API_SECRET instead.
# The client IP is taken from X-Forwarded-For, skipping this many hops.
# Never set higher than the real count, or clients can spoof their IP.
TRUST_PROXY=0

# Shared secret the Next.js server sends with its requests, so the API rate
# limits per visitor (X-Client-IP) instead of per Next.js server. Set the same
# value in the frontend. At least 32 chars: `openssl rand -base64 48`.
# Required when NODE_ENV=production.
INTERNAL_API_SECRET=

# API docs at /docs (OpenAPI JSON at /docs-json). Defaults to false in production.
SWAGGER_ENABLED=true

# Postgres (DB_HOST is overridden to "postgres" inside docker compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=taklifim
DB_PASSWORD=change_me
DB_NAME=taklifim
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis (REDIS_HOST is overridden to "redis" inside docker compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DB=0

# Host ports exposed by docker compose (change if already in use locally)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# JWT (secrets: at least 32 chars, generate with `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_32_chars
JWT_REFRESH_TTL=2592000

# OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# Telegram Gateway token from https://gateway.telegram.org/account/api
# Leave empty in development: codes are printed to the API logs instead.
# Required when NODE_ENV=production.
TELEGRAM_GATEWAY_TOKEN=

# Object storage (S3-compatible). Locally this is the MinIO container;
# in production point it at AWS S3, Cloudflare R2, etc.
# S3_ENDPOINT is overridden to http://minio:9000 inside docker compose.
# Leave S3_ENDPOINT empty for AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=taklifim
S3_SECRET_KEY=change_me_min_8_chars
S3_BUCKET=taklifim
S3_FORCE_PATH_STYLE=true
# Base URL that public files are served from (bucket URL or CDN).
S3_PUBLIC_URL=http://localhost:9000/taklifim
# Upload size limits. Audio uploads are admin only.
UPLOAD_IMAGE_MAX_SIZE_MB=10
UPLOAD_AUDIO_MAX_SIZE_MB=50

# MinIO host ports (S3 API and web console)
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Public site address: Payme returns buyers to SITE_URL/<lang>/cabinet.
SITE_URL=http://localhost:3001

# Payme Merchant API (merchant cabinet → "Kassa" settings). Set the endpoint
# URL there to SITE_URL/api/payme and the account field to "order_id".
# Sandbox: PAYME_CHECKOUT_URL=https://checkout.test.paycom.uz with the TEST key.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Fiscal receipt data (from your tax setup); leave empty until Payme asks.
PAYME_IKPU=
PAYME_PACKAGE_CODE=
PAYME_VAT_PERCENT=0
