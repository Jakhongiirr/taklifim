# Backend API base URL, used by the Next.js server only.
API_URL=http://localhost:3000

# Shared secret sent with every request to the backend (same value as the
# backend's INTERNAL_API_SECRET), so it rate limits per visitor.
INTERNAL_API_SECRET=

# Reverse proxies in front of this server that append to X-Forwarded-For
# (nginx with $proxy_add_x_forwarded_for, a CDN, ...). The visitor's IP is
# read that many entries from the right. Production must run behind at least
# one: without a proxy the header can be made up by the visitor.
TRUSTED_PROXY_COUNT=1

# Public address of the site, for absolute URLs in link previews (Open Graph).
SITE_URL=https://taklifim.uz
